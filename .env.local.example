# Copia este archivo como .env.local y llena los valores.
# En Vercel, ponlos en: Project Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...   # anon public key (lectura pública)

# Solo servidor (NO lleva NEXT_PUBLIC). Supabase → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # ⚠ secreta: nunca la compartas ni la subas al repo

# Clave que la persona autorizada escribe para poder cargar facturas.
UPLOAD_PASSCODE=pon-aqui-una-clave-fuerte
